{
  "name": "obsidian-audio-recording-timer",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "prebuild": "npm run lint && npm run typecheck",
    "build:dist": "node esbuild.config.mjs production",
    "build": "npm run build:dist && node scripts/export-build.mjs release",
    "build:debug": "node esbuild.config.mjs && node scripts/export-build.mjs debug",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "verify:release": "node scripts/verify-release.mjs",
    "release:check": "npm run verify:release && npm run build",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "^0.14.0",
    "@typescript-eslint/parser": "^8.53.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "obsidian": "1.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
